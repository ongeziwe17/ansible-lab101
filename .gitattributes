# Normalize all text files to LF.
* text=auto eol=lf

# Explicit infrastructure and executable files.
*.sh text eol=lf
Dockerfile text eol=lf
**/Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.mermaid text eol=lf
Makefile text eol=lf

# Do not modify binary files.
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.ico -text
*.pdf -text
